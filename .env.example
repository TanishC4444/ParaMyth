# Optional hybrid retrieval. Keep actual keys in your environment or local .env.
GEMINI_API_KEY=
PARAMYTH_RAG_DATABASE=data/literary_rag.db

# Meta image generation reads the process environment (MODEL_API_KEY is an alias).
MUSE_IMAGE_API_KEY=

# Tiger/PostgreSQL: restricted application role and separate migration owner.
# Read from process environment; neither URL is sent to the browser.
PARAMYTH_DATABASE_URL=
PARAMYTH_MIGRATION_DATABASE_URL=
PARAMYTH_DB_CA_FILE=

# Vultr Serverless Inference for creative drafting, soundtracks and production planning.
VULTR_INFERENCE_API_KEY=

# Optional web research for production plans.
SERPAPI_API_KEY=
SERPAPI_BACKUP_KEYS=

# Advanced workflow API and checkout assets
PARAMYTH_PIPELINE_ROOT=
PARAMYTH_REPO=TanishC4444/ParaMyth
PARAMYTH_REF=main
PARAMYTH_ALLOW_DEMO=false
GH_AI_TOKEN=
